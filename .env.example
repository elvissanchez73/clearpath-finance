# Runtime must be a non-superuser role WITHOUT BYPASSRLS.
DATABASE_URL=postgresql://clearpath_app:REPLACE_ME@127.0.0.1:55439/clearpath
# Migration owner only; never expose this connection to browser code.
DIRECT_URL=postgresql://clearpath_owner:REPLACE_ME@127.0.0.1:55439/clearpath
APP_ORIGIN=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Tests use a separate database and reject non-test database names.
TEST_DATABASE_URL=postgresql://clearpath_app:REPLACE_ME@127.0.0.1:55439/clearpath_test
TEST_DIRECT_URL=postgresql://clearpath_owner:REPLACE_ME@127.0.0.1:55439/clearpath_test
# Optional SMTP/transactional-email integration is intentionally deferred.
# Recurring worker: defaults on in development, off in production.
# Set 1 on a long-running production server to enable; set 0 to disable locally.
# Do not enable in build jobs. Sleeping/serverless hosts need a durable scheduler.
# RECURRING_WORKER_ENABLED=1
