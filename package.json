{
  "name": "clearpath-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:local": "node scripts/local-database.mjs",
    "db:stop": "node scripts/local-database.mjs stop",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "^1.8.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "pg": "^8.16.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
